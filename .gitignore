.DS_Store

/node_modules/
/public/
/resources/
/.hugo_build.lock
package-lock.json

# 历史 Jekyll 本地产物（勿提交）
/_site/
/vendor/
/.bundle/

.idea

volumes/website/logs/
volumes/website/geoip
volumes/website/site/*
!volumes/website/site/.gitkeep
.qoder/**/*.py
.qoder/**/__pycache__/
.qoder/**/*.pyc
cert/

# 本地密钥（见 .env.example）
.env

# coscli 本地产物
coscli.log
coscli_output/

# pnpm 全局缓存（不应进 Git；CI 用 --frozen-lockfile 独立安装）
.pnpm-store/

# 文章媒体母本（COS/CDN 分发，不进 Git；见 docs/MEDIA-STANDARDS.md）
content/**/gallery/**
!content/**/gallery/.gitkeep

# 历史 static 大图（迁移完成后不再提交）
static/assets/images/**
!static/assets/images/.gitkeep

# 本地 Hugo 二进制（可选，体积较大）
.tools/hugo
.tools/hugo145
.tools/hugo158
.tools/*.tar.gz
.tools/
