#!/usr/bin/env bash
# 使用 .hugo-version 锁定的 Hugo；优先使用项目本地安装。
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
VERSION="$(tr -d '[:space:]' < "${ROOT}/.hugo-version")"
LOCAL_BIN="${ROOT}/.tools/hugo-${VERSION}"
HUGO_BIN="${LOCAL_BIN}"
if [[ ! -x "${HUGO_BIN}" ]]; then
  HUGO_BIN="$(command -v hugo || true)"
fi
if [[ -z "${HUGO_BIN}" ]]; then
  echo "未找到 Hugo，请运行 bash bin/install-hugo.sh" >&2
  exit 1
fi
ACTUAL="$("${HUGO_BIN}" version)"
if [[ "${ACTUAL}" != "hugo v${VERSION}-"* && "${ACTUAL}" != "hugo v${VERSION}+"* && "${ACTUAL}" != "hugo v${VERSION} "* ]]; then
  echo "Hugo 版本不匹配：项目要求 ${VERSION}，实际为 ${ACTUAL}" >&2
  echo "请运行 bash bin/install-hugo.sh 安装项目指定版本。" >&2
  exit 1
fi
if [[ "${ACTUAL}" != *"+extended"* ]]; then
  echo "项目需要 Hugo Extended，请运行 bash bin/install-hugo.sh" >&2
  exit 1
fi
exec "${HUGO_BIN}" "$@"
