# 腾讯云 COS / CDN（复制为 .env 本地使用，勿提交 .env）
# Bucket alias / name / endpoint 默认从 ~/.cos.yaml 自动读取，一般无需填写

# COS_BUCKET_ALIAS=media-1300240022
# COS_BUCKET_NAME=media-1300240022
# COS_REGION=ap-nanjing
COS_SECRET_ID=
COS_SECRET_KEY=
MEDIA_CDN_BASE=https://media.xiaolin.fun

# 对象键前缀（与 CDN URL 路径一致；dcos 仓库设为 docs）
COS_PREFIX=life
